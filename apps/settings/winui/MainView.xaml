<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.Resources>
    <Style x:Key="KeyboardStroke" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{ThemeResource KeyboardStrokeBrush}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="19"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
      <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="24"/>
    </Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Padding="32,28,32,28" Spacing="20" MaxWidth="960" HorizontalAlignment="Stretch">
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="52" Height="52" CornerRadius="12" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
          <TextBlock Text="劃" FontSize="30" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="4">
          <TextBlock Text="錦筆劃輸入法" Style="{ThemeResource TitleTextBlockStyle}"/>
          <TextBlock Text="設定你的按鍵，找到順手的輸入方式。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>
      <Border Style="{StaticResource Card}">
        <StackPanel Spacing="16">
          <TextBlock Text="按鍵配置" Style="{ThemeResource SubtitleTextBlockStyle}"/>
          <ComboBox x:Name="Mode" HorizontalAlignment="Stretch" AutomationProperties.Name="輸入配置">
            <ComboBoxItem Content="標準"/>
            <ComboBoxItem Content="傳統"/>
            <ComboBoxItem Content="自訂"/>
          </ComboBox>
          <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch">
            <StackPanel x:Name="Keyboard" Width="840" Spacing="6"/>
          </Viewbox>
          <TextBlock Text="點選字母鍵設定筆畫；其餘按鍵保留原本功能。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel Spacing="12">
          <TextBlock Text="試打看看" Style="{ThemeResource SubtitleTextBlockStyle}"/>
          <TextBlock Text="點下方試打區，再按鍵盤。這裡只預覽筆劃，不會輸出文字或增加學習紀錄。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <Button x:Name="Preview" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="64" Padding="16,12" AutomationProperties.Name="筆劃試打區">
            <TextBlock x:Name="PreviewText" Text="點此開始試打" FontSize="22" TextWrapping="Wrap"/>
          </Button>
        </StackPanel>
      </Border>
      <Border x:Name="Habits" Style="{StaticResource Card}">
        <StackPanel Spacing="16">
          <TextBlock Text="選字習慣" Style="{ThemeResource SubtitleTextBlockStyle}"/>
          <ToggleSwitch x:Name="Association" Header="逐字模式顯示聯想字" OnContent="選字送出後，用數字接著選下一字" OffContent="不顯示聯想字"/>
          <TextBlock Text="聯想字使用現有詞庫，按筆畫鍵回到查字；空白、Enter 與左右方向鍵維持原程式功能。開啟連續模式會自動關閉聯想字；切回逐字後可自行開啟。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <ToggleSwitch x:Name="Continuous" Header="連續輸入模式" OnContent="空白進下一字，左右修字，Enter 送出整段" OffContent="逐字選字並送出"/>
          <TextBlock Text="切換後請按下方「套用變更」。連續模式的文字會保留底線，直到 Enter 送出；左右移動後按下鍵換字。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <ToggleSwitch x:Name="Reverse" Header="反轉選字鍵順序" OnContent="9 → 1，首字按 9" OffContent="1 → 9，首字按 1"/>
          <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
          <ToggleSwitch x:Name="Learning" Header="學習常用字與聯想" OnContent="記住選字習慣，自動學習常用詞" OffContent="使用原字庫與手動加入的詞"/>
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="紀錄只保存在這台電腦。清除學習紀錄會保留手動加入的詞。" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Button Grid.Column="1" x:Name="ClearLearning" Content="清除學習紀錄"/>
          </Grid>
        </StackPanel>
      </Border>
      <Border x:Name="PersonalWords" Style="{StaticResource Card}">
        <StackPanel Spacing="12">
          <TextBlock Text="個人聯想詞庫" Style="{ThemeResource SubtitleTextBlockStyle}"/>
          <TextBlock Text="成功輸出的 2～8 字漢字片段重複三次後會加入聯想。姓名或常用詞也能手動新增；新增、移除立即儲存。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <TextBox x:Name="WordText" Header="搜尋或新增詞語" PlaceholderText="例如：錦筆劃（2～8 個漢字）" MaxLength="16"/>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="AddWord" Content="新增詞語"/>
            <Button x:Name="RemoveWord" Content="移除選取詞語" IsEnabled="False"/>
            <Button x:Name="RefreshWords" Content="重新整理"/>
          </StackPanel>
          <TextBlock x:Name="WordCount" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <ListView x:Name="WordList" MaxHeight="220" SelectionMode="Single" AutomationProperties.Name="個人聯想詞語"/>
        </StackPanel>
      </Border>
      <TextBlock Text="外觀會跟隨 Windows 的深色／淺色設定。" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
    </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="24,12">
    <StackPanel Spacing="10">
      <InfoBar x:Name="Status" IsOpen="False" IsClosable="True"/>
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="Reset" Content="恢復預設配置" HorizontalAlignment="Left"/>
        <Button Grid.Column="1" x:Name="Close" Content="關閉" MinWidth="90"/>
        <Button Grid.Column="2" x:Name="Apply" Content="套用變更" MinWidth="120" Style="{ThemeResource AccentButtonStyle}"/>
      </Grid>
    </StackPanel>
  </Border>
</Grid>
