# CMake-only harness; product and builder code remain C++.
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(root "${WORK}/${run_id}/字庫測試")
file(MAKE_DIRECTORY "${root}")
function(run_ok)
    execute_process(COMMAND "${TOOL}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Command failed: ${ARGN}\n${output}\n${error}")
    endif()
endfunction()
run_ok(build --source "${SOURCE}" --output "${root}/first")
run_ok(build --source "${SOURCE}" --output "${root}/second")
file(SHA256 "${root}/first/dictionary.sidx" hash_first)
file(SHA256 "${root}/second/dictionary.sidx" hash_second)
if(NOT hash_first STREQUAL hash_second)
    message(FATAL_ERROR "Builds are not byte-identical")
endif()
execute_process(COMMAND "${TOOL}" build --source "${SOURCE}" --output "${root}/first"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(NOT result EQUAL 2)
    message(FATAL_ERROR "Existing bundle should be rejected")
endif()
file(SHA256 "${root}/first/dictionary.sidx" hash_after)
if(NOT hash_first STREQUAL hash_after)
    message(FATAL_ERROR "Existing bundle was modified")
endif()
run_ok(inspect --index "${root}/first/dictionary.sidx")
execute_process(COMMAND "${TOOL}" query --index "${root}/first/dictionary.sidx" --strokes 12125145154121
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT output MATCHES "U[+]000081FA")
    message(FATAL_ERROR "Expected actual character U+81FA from query: ${error}")
endif()
file(WRITE "${root}/bad.tsv" "remove\tU+20BB7\t-\t-\tCannot remove missing character\n")
execute_process(COMMAND "${TOOL}" build --source "${SOURCE}" --output "${root}/bad"
    --overrides "${root}/bad.tsv" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(NOT result EQUAL 2 OR EXISTS "${root}/bad" OR EXISTS "${root}/bad.staging")
    message(FATAL_ERROR "Invalid overrides must not publish an artifact")
endif()
file(WRITE "${root}/extra.tsv" "add\tU+20BB7\t121251\tshared\tSynthetic integration fixture, not a linguistic assertion\n")
run_ok(build --source "${SOURCE}" --output "${root}/patched" --overrides "${root}/extra.tsv")
execute_process(COMMAND "${TOOL}" query --index "${root}/patched/dictionary.sidx" --strokes 121251
    RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0 OR NOT output MATCHES "U[+]00020BB7")
    message(FATAL_ERROR "Supplementary-plane override missing")
endif()
if(NOT EXISTS "${root}/patched/sources/override-1.tsv" OR NOT EXISTS "${root}/patched/NOTICE.txt")
    message(FATAL_ERROR "Missing source/license audit trail")
endif()
message(STATUS "CLI reproducibility, lookup, non-overwrite and override tests passed: ${root}")
